# Skopiuj do .env i wpisz klucz z web3forms.com. Plik .env nie trafia do repo.
# Bez klucza formularze działają w trybie demo (komunikat sukcesu, payload w konsoli).
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4: identyfikator pomiaru G-XXXX z analytics.google.com. Bez niego strona nie ładuje
# Google Analytics ani baneru zgody. Włącz dopiero po akceptacji tekstów baneru i polityki prywatności.
PUBLIC_GA_ID=
