---
// Konsultacja (#kontakt): 6+6. Lewa: opis i telefon. Prawa: formularz.
import SectionHead from './ui/SectionHead.astro';
import Form from './ui/Form.astro';
import Field from './ui/Field.astro';
import { site } from '../content/site';

const { contactSection: section, contact } = site;
const { form } = section;
const formId = 'kontakt-formularz';
---

<section class="section container" id="kontakt">
  <div class="grid">
    <div class="col-6">
      <SectionHead label={section.label} title={section.title} text={section.text} />
      <p class="label mt-l">{section.phoneLabel}</p>
      <p class="mt-xs">
        <a class="num2 phone nowrap" href={contact.phoneHref}>{contact.phone}</a>
      </p>
    </div>
    <div class="col-6">
      <Form id={formId} subject={form.subject} submit={form.submit} consent={form.consent}>
        <Field
          form={formId}
          name="name"
          label={form.name}
          placeholder={form.namePlaceholder}
          required
          autocomplete="name"
        />
        <Field
          form={formId}
          name="email"
          label={form.email}
          placeholder={form.emailPlaceholder}
          type="email"
          required
          autocomplete="email"
        />
        <Field
          form={formId}
          name="region"
          label={form.region}
          type="select"
          placeholderOption={form.regionPlaceholder}
          options={form.regionOptions}
        />
        <Field
          form={formId}
          name="wiadomosc"
          label={form.message}
          placeholder={form.messagePlaceholder}
          type="textarea"
        />
        <p slot="success">{form.success}</p>
      </Form>
    </div>
  </div>
</section>

<style>
  .phone {
    text-decoration: none;
  }

  .phone:hover {
    color: var(--muted);
  }
</style>
