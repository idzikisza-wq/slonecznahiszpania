---
// Nagłówek (pasek z WebHero): logo kwadrat-logo.svg 40px na białym, menu tekstowe 15px 600 w ink,
// telefon jako tekst „Zadzwoń …” (bez ikony). Pod paskiem linia 1px line. Nie sticky.
// Poniżej 1200px (tablet i telefon) linki chowane pod przyciskiem tekstowym „Menu”, telefon zostaje.
import { site, SHOW_OFFERS } from '../content/site';

const { header, contact } = site;
const nav = header.nav.filter((item) => SHOW_OFFERS || item.href !== '/#oferty');
---

<a class="skip-link" href="#tresc">{header.skipLink}</a>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/brand/kwadrat-logo.svg" alt={header.logoAlt} width="40" height="40" />
    </a>
    <nav class="site-nav" id="nawigacja" aria-label={header.navLabel}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="nav-link header-phone" href={contact.phoneHref}>
      {header.phoneLabel}{' '}<span class="nowrap">{contact.phone}</span>
    </a>
    <button class="nav-link menu-toggle" type="button" aria-expanded="false" aria-controls="nawigacja">
      {header.menu}
    </button>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: var(--side);
    top: var(--space-xs);
    z-index: 1;
    padding: var(--space-xs) var(--space-s);
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    border-bottom: var(--rule) solid var(--line);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'brand nav phone toggle';
    align-items: center;
    column-gap: 28px;
    padding-block: 20px;
  }

  .brand {
    grid-area: brand;
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  .site-nav {
    grid-area: nav;
    justify-self: end;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: 28px;
    row-gap: var(--space-xs);
  }

  .nav-link {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
  }

  a.nav-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .site-nav .nav-link {
    display: inline-block;
    padding-block: var(--space-xs);
  }

  .header-phone {
    grid-area: phone;
  }

  .menu-toggle {
    grid-area: toggle;
    display: none;
    padding: var(--space-xs) 0;
    border: 0;
    border-radius: 0;
    background: none;
    cursor: pointer;
  }

  /* Tablet i telefon: menu pod przyciskiem tekstowym „Menu”, telefon obok */
  @media (max-width: 1199.98px) {
    .header-inner {
      grid-template-areas:
        'brand . phone toggle'
        'nav nav nav nav';
    }

    :global(.js) .menu-toggle {
      display: block;
    }

    .site-nav {
      justify-self: stretch;
    }

    :global(.js) .site-nav:not(.is-open) {
      display: none;
    }

    .site-nav ul {
      flex-direction: column;
      padding-top: var(--space-s);
    }
  }

  @media (max-width: 767.98px) {
    .header-inner {
      column-gap: var(--space-s);
      padding-block: var(--space-s);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('nawigacja');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
</script>
