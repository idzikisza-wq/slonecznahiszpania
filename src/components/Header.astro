---
// Nagłówek (pasek z WebHero): lockup kwadrat-logo-lockup.svg (znak 40px z napisem NIERUCHOMOŚCI)
// na białym, pod nim etykieta „Hiszpania · Costa del Sol · Costa Blanca” (decyzja Idziego 5.10.2026,
// jak na live). Menu tekstowe 15px 600 w ink, telefon jako piktogram słuchawki i numer (piktogram
// zamiast słowa „Zadzwoń”, decyzja Idziego 5.10.2026); nazwa linku dla czytników to „Zadzwoń …”.
// Pod paskiem linia 1px line. Nie sticky.
// Poniżej 1200px (tablet i telefon) linki chowane pod przyciskiem tekstowym „Menu”, telefon zostaje,
// etykieta schodzi do osobnego wiersza pod lockupem. Na telefonie sam piktogram w polu 40 × 40px
// (numer jest w nazwie linku), więc lockup ma pełną szerokość nawet przy 320px.
// Kolejność w HTML = kolejność tabulacji: menu stoi zaraz za przyciskiem „Menu”, więc Tab po
// otwarciu wchodzi w linki. Telefon jest dwa razy, widoczny zawsze tylko jeden: przed przyciskiem
// (tablet i telefon) albo za menu (od 1200px). Escape zamyka menu i wraca na przycisk.
import PhoneIcon from './ui/PhoneIcon.astro';
import { site, SHOW_OFFERS } from '../content/site';
import { plainText } from '../content/typo';

const { header, contact } = site;
const nav = header.nav.filter((item) => SHOW_OFFERS || item.href !== '/#oferty');
// Nazwa linku telefonu: zawiera widoczny numer (WCAG 2.5.3), na telefonie zastępuje go w całości
const phoneName = plainText(`${header.phoneLabel} ${contact.phone}`);
---

<a class="skip-link" href="#tresc">{header.skipLink}</a>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/brand/kwadrat-logo-lockup.svg" alt={header.logoAlt} width="148" height="40" />
    </a>
    <p class="label header-tagline">{header.tagline}</p>
    <a class="nav-link header-phone header-phone--top" href={contact.phoneHref} aria-label={phoneName}>
      <PhoneIcon /><span class="header-phone-number nowrap">{contact.phone}</span>
    </a>
    <button class="nav-link menu-toggle" type="button" aria-expanded="false" aria-controls="nawigacja">
      {header.menu}
    </button>
    <nav class="site-nav" id="nawigacja" aria-label={header.navLabel}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="nav-link header-phone header-phone--end" href={contact.phoneHref} aria-label={phoneName}>
      <PhoneIcon /><span class="nowrap">{contact.phone}</span>
    </a>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: var(--side);
    top: var(--space-xs);
    z-index: 1;
    padding: var(--space-xs) var(--space-s);
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    border-bottom: var(--rule) solid var(--line);
  }

  /* Od 1200px: lockup z etykietą pod spodem po lewej, menu i telefon na środku ich wysokości */
  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'brand nav phone'
      'tagline nav phone';
    align-items: center;
    column-gap: var(--gutter);
    padding-block: 20px;
  }

  .brand {
    grid-area: brand;
    justify-self: start;
  }

  /* Lockup w proporcjach pliku (248,352 × 67,012): znak 40px jak w stopce. Gdyby zabrakło
     miejsca (węziej niż 320px), zmniejsza się proporcjonalnie, zamiast wypychać telefon i „Menu”. */
  .brand img {
    display: block;
    width: 148px;
    max-width: 100%;
    height: auto;
  }

  .header-tagline {
    grid-area: tagline;
    margin-top: 6px;
  }

  .site-nav {
    grid-area: nav;
    justify-self: end;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: var(--gutter);
    row-gap: var(--space-xs);
  }

  .nav-link {
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
  }

  a.nav-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .site-nav .nav-link {
    display: inline-block;
    padding-block: var(--space-xs);
  }

  /* Telefon: piktogram 16px i numer, odstęp 8px; podkreślenie przy hover dostaje tylko numer */
  .header-phone {
    grid-area: phone;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .header-phone--top {
    display: none;
  }

  .header-phone :global(.phone-icon) {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .menu-toggle {
    grid-area: toggle;
    display: none;
    padding: var(--space-xs) 0;
    border: 0;
    border-radius: 0;
    background: none;
    cursor: pointer;
  }

  /* Tablet i telefon: menu pod przyciskiem tekstowym „Menu”, telefon obok.
     Bez JS przycisku nie ma, a menu stoi otwarte pod paskiem. */
  @media (max-width: 1199.98px) {
    .header-inner {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'brand phone'
        'tagline tagline'
        'nav nav';
    }

    :global(.js) .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'brand phone toggle'
        'tagline tagline tagline'
        'nav nav nav';
    }

    .header-phone {
      justify-self: end;
    }

    .header-phone--top {
      display: flex;
    }

    .header-phone--end {
      display: none;
    }

    :global(.js) .menu-toggle {
      display: block;
    }

    .site-nav {
      justify-self: stretch;
    }

    :global(.js) .site-nav:not(.is-open) {
      display: none;
    }

    .site-nav ul {
      flex-direction: column;
      padding-top: var(--space-s);
    }
  }

  @media (max-width: 767.98px) {
    .header-inner {
      column-gap: var(--space-s);
      padding-block: var(--space-s);
    }

    /* Sam piktogram 20px w polu dotyku 40 × 40px; numer jest w nazwie linku (aria-label) */
    .header-phone--top {
      justify-content: center;
      width: 40px;
      height: 40px;
    }

    .header-phone--top :global(.phone-icon) {
      width: 20px;
      height: 20px;
    }

    .header-phone-number {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('nawigacja');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  // Escape zamyka menu tylko z fokusem w menu albo na przycisku (nie przy pisaniu w formularzu)
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    const active = document.activeElement;
    if (active !== toggle && !nav?.contains(active)) return;
    setOpen(false);
    toggle?.focus();
  });
</script>
