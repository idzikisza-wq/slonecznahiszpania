---
// Nagłówek: logo lockup, cztery linki w label, na końcu CTA główny „Konsultacja".
// Nie sticky. Na mobile linki i przycisk chowane pod słowem MENU, bez ikony.
import { site, SHOW_OFFERS } from '../content/site';

const { header } = site;
const nav = header.nav.filter((item) => SHOW_OFFERS || item.href !== '/#oferty');
---

<a class="skip-link nav-link" href="#tresc">{header.skipLink}</a>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/brand/kwadrat-logo-lockup.svg" alt={header.logoAlt} width="134" height="36" />
    </a>
    <button class="nav-link menu-toggle" type="button" aria-expanded="false" aria-controls="nawigacja">
      {header.menu}
    </button>
    <nav class="site-nav" id="nawigacja" aria-label={header.navLabel}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="cta header-cta" href={header.cta.href}>{header.cta.label}</a>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: var(--side);
    top: var(--space-xs);
    z-index: 1;
    padding: var(--space-xs) var(--space-s);
    background: var(--paper);
    color: var(--ink);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    border-bottom: var(--rule) solid var(--line);
  }

  /* Bez dodatkowego breakpointu: przy wąskim ekranie nawigacja sama spada pod logo */
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-s);
  }

  .brand img {
    width: auto;
    height: 36px;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-s) var(--space-m);
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--gutter);
    row-gap: var(--space-xs);
  }

  .nav-link {
    color: var(--ink);
    text-decoration: none;
  }

  a.nav-link:hover {
    color: var(--muted);
  }

  .site-nav .nav-link {
    display: inline-block;
    padding-block: var(--space-xs);
  }

  .menu-toggle {
    display: none;
    padding: var(--space-xs) 0;
    border: 0;
    border-radius: 0;
    background: none;
    cursor: pointer;
  }

  @media (max-width: 759.98px) {
    .brand img {
      height: 28px;
    }

    :global(.js) .menu-toggle {
      display: block;
    }

    .site-nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
      margin-left: 0;
      padding-bottom: var(--space-s);
    }

    :global(.js) .site-nav:not(.is-open) {
      display: none;
    }

    .site-nav ul {
      flex-direction: column;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('nawigacja');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
</script>
