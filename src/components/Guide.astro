---
// 3. Poradnik (#poradnik): 6+6. Lewa: opis i lista atutów. Prawa: formularz od góry kolumny,
// Imię i Nazwisko w jednym rzędzie.
import SectionHead from './ui/SectionHead.astro';
import List from './ui/List.astro';
import Form from './ui/Form.astro';
import Field from './ui/Field.astro';
import { site } from '../content/site';

const { guide } = site;
const { form } = guide;
const formId = 'poradnik-formularz';
---

<section class="section container" id="poradnik">
  <div class="grid">
    <div class="col-6">
      <SectionHead label={guide.label} title={guide.title} text={guide.text} />
      <div class="mt-m">
        <List items={guide.list} variant="plus" />
      </div>
      <p class="small mt-m">{guide.note}</p>
    </div>

    <div class="col-6">
      <Form id={formId} subject={form.subject} submit={form.submit} consent={form.consent}>
        <div class="field-row">
          <Field form={formId} name="imie" label={form.firstName} required autocomplete="given-name" />
          <Field form={formId} name="nazwisko" label={form.lastName} required autocomplete="family-name" />
        </div>
        <Field form={formId} name="email" label={form.email} type="email" required autocomplete="email" />
        <Fragment slot="success">
          <p>{form.success}</p>
          <p class="mt-s">
            <a class="cta-2" href={form.pdf} download>{form.download}</a>
          </p>
        </Fragment>
      </Form>
    </div>
  </div>
</section>
