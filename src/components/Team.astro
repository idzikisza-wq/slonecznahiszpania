---
// Na miejscu w Hiszpanii (#na-miejscu, prośba Idziego 7.10.2026): rezydenci i lokalni agenci.
// Etykieta, nagłówek i akapit. Od 16.11.2026 bez zdjęcia i bez imion (prośba Idziego).
// Bez telefonów i e-maili: na stronie jest jeden numer.
import SectionHead from './ui/SectionHead.astro';
import { site } from '../content/site';

const { team } = site;
---

<section class="section" id="na-miejscu">
  <div class="container">
    <SectionHead label={team.label} title={team.title} text={team.text} />
  </div>
</section>
