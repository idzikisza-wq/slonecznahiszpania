---
// Obsługa 360° (#bezpieczenstwo): 6+6. Lewa: etykieta, nagłówek, akapit. Prawa: lista atutów
// (najwyżej pięć punktów). Sekcja oddzielona cienką linią (dawny pas na ciemnym tle).
import SectionHead from './ui/SectionHead.astro';
import List from './ui/List.astro';
import { site } from '../content/site';

const { service } = site;
---

<section class="section section--ruled container" id="bezpieczenstwo">
  <div class="grid">
    <div class="col-6">
      <SectionHead label={service.label} title={service.title} text={service.text} />
    </div>
    <div class="col-6">
      <List items={service.list} variant="plus" />
    </div>
  </div>
</section>
