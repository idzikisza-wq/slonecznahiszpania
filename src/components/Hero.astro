---
// Hero (#start, WebHero): etykieta, H1 w dwóch grubościach (początek 400, puenta 700, jeden kolor
// ink), lead, jeden przycisk główny i jeden link drugi, zdjęcie w naturalnych proporcjach obok
// tekstu (7+5) z podpisem „Zdjęcie poglądowe”. Bez nakładek i przyciemnień. Pod spodem pasek KPI
// (WebStats) i dwa kierunki. Tablet i telefon: zdjęcie pod przyciskiem.
import Photo from './ui/Photo.astro';
import Stats from './Stats.astro';
import { site, PHOTO_NOTE } from '../content/site';
import { typoText } from '../content/typo';

const { hero } = site;
const photoNote = typoText(PHOTO_NOTE);
---

<section class="hero" id="start">
  <div class="container">
    <div class="grid hero-grid">
      <div class="col-7">
        <p class="label">{hero.label}</p>
        <h1 class="hero-title">
          <span class="hero-line">{hero.title.start}</span>{' '}<b class="hero-line">{hero.title.end}</b>
        </h1>
        <p class="lead hero-lead">{hero.lead}</p>
        <div class="actions hero-actions">
          <a class="cta" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
          <a class="cta-2" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
        </div>
        <p class="small hero-note">{hero.note}</p>
      </div>
      <figure class="col-5">
        <Photo
          image={hero.image}
          sizes="(min-width: 1200px) 453px, (min-width: 768px) calc(100vw - 80px), calc(100vw - 40px)"
          eager
        />
        {photoNote && <figcaption class="small">{photoNote}</figcaption>}
      </figure>
    </div>

    <div class="hero-stats">
      <Stats />
    </div>

    <div class="grid directions">
      {
        hero.directions.map((item) => (
          <article class="col-6 direction">
            <p class="label">{item.label}</p>
            <h2 class="h3 mt-xs">{item.title}</h2>
            <p class="mt-xs">{item.text}</p>
            <p class="mt-s">
              <a class="cta-2" href={item.link.href}>
                {item.link.label}
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 48px;
    padding-bottom: var(--section);
  }

  .hero-grid {
    align-items: end;
  }

  .hero-title {
    margin-top: var(--space-s);
  }

  .hero-line {
    display: block;
  }

  .hero-lead {
    margin-top: 20px;
  }

  .hero-actions {
    margin-top: 32px;
  }

  .hero-note {
    margin-top: var(--space-s);
  }

  .hero-stats {
    margin-top: 64px;
  }

  .directions {
    margin-top: 64px;
  }

  .direction {
    border-top: var(--rule) solid var(--ink);
    padding-top: 14px;
  }

  @media (max-width: 767.98px) {
    .hero {
      padding-top: var(--block);
    }

    .hero-stats,
    .directions {
      margin-top: var(--block);
    }
  }
</style>
