---
// Stopka (WebFooter): linia 1px ink nad stopką, tekst 13/20px muted, nagłówki kolumn 700 ink.
// Trzy kolumny 4+4+4 (na telefonie jedna): marka z linkiem do kwadrat.io i social media tekstem,
// kontakt agenta (AGENT w site.ts), dane spółki z adresem biuro@kwadrat.io (decyzja Idziego
// 4.10.2026). Pasek dolny za linią 1px line: zastrzeżenie i polityka prywatności. Bez ikon.
import { site, AGENT, SOCIAL } from '../content/site';
import { typoText } from '../content/typo';

const { footer, company, contact } = site;
const SEP = ' · ';
---

<footer class="container">
  <div class="kw-foot">
    <div class="kw-cols">
      <div>
        <img src="/brand/kwadrat-logo.svg" alt="" width="40" height="40" />
        <p>
          <b>{company.brand}</b><br />{company.network}{SEP}<a href={company.website}>{company.websiteLabel}</a>
        </p>
        <p class="mt-s">
          {
            SOCIAL.map((item, index) => (
              <>
                {index > 0 && SEP}
                <a href={item.href}>{item.label}</a>
              </>
            ))
          }
        </p>
      </div>
      <div>
        <p>
          <b>{footer.contactHeading}</b><br />{AGENT.name}<br /><a href={AGENT.phoneHref}
            >{typoText(`${footer.phonePrefix} ${AGENT.phone}`)}</a
          ><br /><a href={`mailto:${AGENT.email}`}>{AGENT.email}</a><br />{typoText(AGENT.address)}
        </p>
      </div>
      <div>
        <p>
          <b>{company.legalName}</b>
          {
            footer.company.map((line) => (
              <>
                <br />
                {line.map((part, index) => (
                  <>
                    {index > 0 && ' '}
                    <span class="nowrap">{part}</span>
                  </>
                ))}
              </>
            ))
          }
          <br /><a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>
    </div>
    <div class="kw-legal">
      <p>{footer.disclaimer}</p>
      <p><a href={footer.privacy.href}>{footer.privacy.label}</a></p>
    </div>
  </div>
</footer>
