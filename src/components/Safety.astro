---
// 11. Bezpieczeństwo (#bezpieczenstwo): akapit i tabela danych spółki.
import SectionHead from './ui/SectionHead.astro';
import DataTable from './ui/DataTable.astro';
import { site } from '../content/site';

const { safety } = site;
---

<section class="section container" id="bezpieczenstwo">
  <SectionHead label={safety.label} title={safety.title} text={safety.text} />
  <div class="mt-l">
    <DataTable rows={safety.rows} />
  </div>
</section>
