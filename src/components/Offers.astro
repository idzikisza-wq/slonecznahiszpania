---
// Przykładowe nieruchomości (#oferty): trzy oferty 4+4+4. Zdjęcie w naturalnych proporcjach,
// pod nim podpis „Wizualizacja" (stała OFFER_PHOTO_NOTE), lokalizacja, tytuł, parametry, cena.
// Bez ramek i przycisków. Z polem href tytuł staje się linkiem do oferty.
// Sekcję i pozycję „Oferty" w menu włącza przełącznik SHOW_OFFERS w site.ts.
import SectionHead from './ui/SectionHead.astro';
import Photo from './ui/Photo.astro';
import { site, OFFER_PHOTO_NOTE } from '../content/site';
import { typoText } from '../content/typo';

const { offers } = site;
const photoNote = typoText(OFFER_PHOTO_NOTE);
---

<section class="section" id="oferty">
  <div class="container">
  <SectionHead label={offers.label} title={offers.title} note={offers.note} />
  <ul class="tiles mt-l">
    {
      offers.items.map((offer) => (
        <li class="tile tile--plain" style="--span: 4; --rows: 5">
          <figure>
            <Photo
              image={offer.image}
              sizes="(min-width: 1200px) 357px, (min-width: 768px) calc(100vw - 80px), calc(100vw - 40px)"
            />
            {photoNote && <figcaption class="small">{photoNote}</figcaption>}
          </figure>
          <p class="label tile-after-photo">{offer.location}</p>
          <h3>{offer.href ? <a class="offer-link" href={offer.href}>{offer.title}</a> : offer.title}</h3>
          <p class="small">{offer.details.join(' · ')}</p>
          <p class="kpi tile-price">{offer.price}</p>
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .offer-link {
    text-decoration: none;
  }

  .offer-link:hover {
    color: var(--muted);
  }
</style>
