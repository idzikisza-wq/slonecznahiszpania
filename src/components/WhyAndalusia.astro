---
// 6. Dlaczego Andaluzja (#dlaczego-andaluzja): jedna sekcja, cztery kafelki tekstowe 6+6
// (sezonowość, Málaga jako miasto, lotnisko, zabudowa), pod nimi źródło liczby mieszkańców.
import SectionHead from './ui/SectionHead.astro';
import TextTiles from './ui/TextTiles.astro';
import { site } from '../content/site';

const { whyAndalusia } = site;
const { source } = whyAndalusia;
---

<section class="section container" id="dlaczego-andaluzja">
  <SectionHead label={whyAndalusia.label} title={whyAndalusia.title} lead={whyAndalusia.lead} />
  <div class="mt-l">
    <TextTiles items={whyAndalusia.items} span={6} />
  </div>
  <p class="small mt-m">
    {source.lead} <a class="source-link" href={source.href}>{source.label}</a>.
  </p>
</section>

<style>
  .source-link {
    color: inherit;
    text-underline-offset: 3px;
  }

  .source-link:hover {
    color: var(--ink);
  }
</style>
