---
// Opinie (#opinie): 4+4+4. Kafelek z oceną 4,9 (jedyna czerwona liczba na stronie)
// i dwie opinie jako callout. Bez gwiazdek i bez logo Google. Uwaga pod liczbą w jednej linii,
// nazwa wizytówki i data odczytu w osobnej linii pod nią (checklista z 08_DOKUMENTY_KWADRAT.md).
import SectionHead from './ui/SectionHead.astro';
import { site } from '../content/site';

const { reviews } = site;
const { rating } = reviews;
---

<section class="section container" id="opinie">
  <SectionHead label={reviews.label} title={reviews.title} text={reviews.text} />
  <div class="grid mt-l">
    <div class="col-4">
      <div class="tile">
        <p class="label">{rating.label}</p>
        <p class="kpi nowrap">
          <span class="kpi--accent">{rating.value}</span>{' '}<span class="num2">{rating.scale}</span>
        </p>
        <p class="small">{rating.note}</p>
        {
          (rating.profileName || rating.readDate) && (
            <p class="small">
              {rating.profileName && `„${rating.profileName}”`}{rating.profileName && rating.readDate && ', '}{rating.readDate && <span class="nowrap">{`stan na ${rating.readDate}`}</span>}
            </p>
          )
        }
        <p class="mt-m">
          <a class="cta-2" href={reviews.cta.href}>{reviews.cta.label}</a>
        </p>
      </div>
    </div>
    {
      reviews.quotes.map((quote) => (
        <figure class="col-4 callout">
          <blockquote>
            <p>„{quote.text}”</p>
          </blockquote>
          <figcaption class="small mt-s">
            {quote.author} · {quote.meta}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
