---
// 5. Dlaczego Hiszpania (#dlaczego-hiszpania): trzy kafelki tekstowe, podsekcja z ryzykami.
import SectionHead from './ui/SectionHead.astro';
import TextTiles from './ui/TextTiles.astro';
import List from './ui/List.astro';
import { site } from '../content/site';

const { whySpain } = site;
const { risks } = whySpain;
---

<section class="section container" id="dlaczego-hiszpania">
  <SectionHead label={whySpain.label} title={whySpain.title} lead={whySpain.lead} />
  <div class="mt-l">
    <TextTiles items={whySpain.items} span={4} />
  </div>

  <div class="subsection">
    <SectionHead label={risks.label} title={risks.title} text={risks.text} level="h3" />
    <div class="mt-l">
      <List items={risks.items} variant="minus" />
    </div>
  </div>
</section>
