---
// Dlaczego Hiszpania (#dlaczego-hiszpania): trzy kafelki tekstowe 4+4+4,
// pod nimi callout „Ryzyka nazywamy wprost" (lewa krawędź, bez tła i bez ikony).
import SectionHead from './ui/SectionHead.astro';
import TextTiles from './ui/TextTiles.astro';
import { site } from '../content/site';

const { whySpain } = site;
const { risks } = whySpain;
---

<section class="section container" id="dlaczego-hiszpania">
  <SectionHead label={whySpain.label} title={whySpain.title} lead={whySpain.lead} />
  <div class="mt-l">
    <TextTiles items={whySpain.items} span={4} />
  </div>
  <div class="callout mt-l">
    <h3>{risks.title}</h3>
    <p class="mt-xs">{risks.text}</p>
  </div>
</section>
