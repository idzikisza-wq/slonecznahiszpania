---
// Kafelki tekstowe: linia 1px ink nad, opcjonalnie etykieta (np. 01) i druga etykieta z miejscami,
// potem H3, akapit i opcjonalnie link drugi (np. „Porozmawiajmy” w celach). Każdy rząd to osobna
// siatka z subgridem, części kafelków wyrównane w poziomie. Poniżej 1200px kafelki stoją jeden pod drugim.
interface Tile {
  label?: string;
  places?: string;
  title: string;
  text: string;
  link?: { label: string; href: string };
}

interface Props {
  items: Tile[];
  span: 4 | 6;
}

const { items, span } = Astro.props;
const perRow = 12 / span;
const rowsOfTiles = Array.from({ length: Math.ceil(items.length / perRow) }, (_, i) =>
  items.slice(i * perRow, (i + 1) * perRow),
);
// Wszystkie kafelki mają te same części (pusta etykieta zostaje pustym wierszem),
// więc subgrid wyrównuje je w poziomie także wtedy, gdy któryś kafelek nie ma etykiety.
const hasLabel = items.some((item) => item.label);
const hasPlaces = items.some((item) => item.places);
const hasLink = items.some((item) => item.link);
const parts = (hasLabel ? 1 : 0) + (hasPlaces ? 1 : 0) + 2 + (hasLink ? 1 : 0);
---

{
  rowsOfTiles.map((row) => (
    <ul class="tiles">
      {row.map((item) => (
        <li class="tile" style={`--span: ${span}; --rows: ${parts}`}>
          {hasLabel && <p class="label">{item.label}</p>}
          {hasPlaces && <p class="label">{item.places}</p>}
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          {hasLink && (
            <p class="tile-link">
              {item.link && (
                <a class="cta-2" href={item.link.href}>
                  {item.link.label}
                </a>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
  ))
}
