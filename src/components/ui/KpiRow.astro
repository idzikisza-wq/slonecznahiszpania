---
// Rząd kafelków z liczbą: linia mocna nad, label, liczba kpi, uwaga small.
// Subgrid: liczby w rzędzie stoją na jednej wysokości.
interface Kpi {
  label?: string;
  value: string;
  note: string;
}

interface Props {
  items: Kpi[];
  span?: 3 | 4 | 6;
}

const { items, span = 4 } = Astro.props;
const rows = items.some((item) => item.label) ? 3 : 2;
---

<ul class="tiles">
  {
    items.map((item) => (
      <li class="tile" style={`--span: ${span}; --rows: ${rows}`}>
        {rows === 3 && <p class="label">{item.label}</p>}
        <p class="kpi">{item.value}</p>
        <p class="small">{item.note}</p>
      </li>
    ))
  }
</ul>
