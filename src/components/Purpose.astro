---
// Po co kupujesz (#cele): trzy kafelki tekstowe 4+4+4, w każdym link drugi „Porozmawiajmy” do #kontakt
// (decyzja Idziego 5.10.2026, jak na live). Bez przycisku głównego pod rzędem: linki prowadzą tam samo.
import SectionHead from './ui/SectionHead.astro';
import TextTiles from './ui/TextTiles.astro';
import { site } from '../content/site';

const { purpose } = site;
---

<section class="section" id="cele">
  <div class="container">
    <SectionHead label={purpose.label} title={purpose.title} lead={purpose.lead} />
    <div class="mt-l">
      <TextTiles items={purpose.items} span={4} />
    </div>
  </div>
</section>
