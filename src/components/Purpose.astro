---
// 4. Po co kupujesz: trzy kafelki tekstowe 4+4+4, pod rzędem jeden CTA główny.
import SectionHead from './ui/SectionHead.astro';
import TextTiles from './ui/TextTiles.astro';
import { site } from '../content/site';

const { purpose } = site;
---

<section class="section container">
  <SectionHead label={purpose.label} title={purpose.title} lead={purpose.lead} />
  <div class="mt-l">
    <TextTiles items={purpose.items} span={4} />
  </div>
  <p class="mt-l">
    <a class="cta" href={purpose.cta.href}>{purpose.cta.label}</a>
  </p>
</section>
