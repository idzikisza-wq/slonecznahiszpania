---
// Szablon w stylu systemu. Treść polityki dostarczy Idzi: nie pisać tekstu prawnego.
import Base from '../layouts/Base.astro';
import { site } from '../content/site';

const { privacy, meta } = site;
---

<Base title={privacy.metaTitle} description={meta.description}>
  <section class="section hero-privacy container">
    <h1>{privacy.title}</h1>
    <p class="mt-m">{privacy.body}</p>
  </section>
</Base>

<style>
  .hero-privacy {
    margin-top: var(--space-xl);
  }
</style>
